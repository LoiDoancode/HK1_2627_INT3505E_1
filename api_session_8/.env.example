# ==========================================
# Cấu hình biến môi trường theo chuẩn 12-factor (Slide 31)
# ==========================================

# Database URL
# Chạy SQLite nội bộ: sqlite:///dev.db
# Chạy PostgreSQL: postgresql+psycopg2://app:devpw@localhost:5432/appdb
DB_URL=sqlite:///dev.db

# Flask Secret Key
SECRET_KEY=change-this-to-a-secure-random-token-in-production

# Cấu hình Class (config.DefaultConfig / config.ProductionConfig)
APP_CONFIG=config.DefaultConfig

# Mức Log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

