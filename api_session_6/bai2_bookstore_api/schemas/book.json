{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "title",
        "isbn",
        "price_vnd"
    ],
    "properties": {
        "title": {
            "type": "string",
            "minLength": 1
        },
        "isbn": {
            "type": "string",
            "pattern": "^\\d{13}$"
        },
        "price_vnd": {
            "type": "number",
            "minimum": 0
        },
        "stock": {
            "type": "integer",
            "minimum": 0
        },
        "category_slug": {
            "type": "string"
        }
    },
    "additionalProperties": false
}