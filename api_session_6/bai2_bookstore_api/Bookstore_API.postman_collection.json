		{
			"name": "4. Sort Multi-key",
			"item": [
				{
					"name": "4.1. Sort đa khóa: price,-id (Giá tăng dần, ID giảm dần)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Prices are in ascending order\", function () {",
									"    var jsonData = pm.response.json();",
									"    var prices = jsonData.data.map(function(b) { return b.price.amount; });",
									"    for (var i = 1; i < prices.length; i++) {",
									"        pm.expect(prices[i]).to.be.at.least(prices[i - 1]);",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/books?strategy=offset&limit=20&sort=price,-id",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
