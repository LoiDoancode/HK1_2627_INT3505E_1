		{
			"name": "2. Cursor Pagination",
			"item": [
				{
					"name": "2.1. Cursor - Lấy trang đầu tiên (Lưu next_cursor tự động)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"pm.test(\"Has next_cursor\", function () {",
									"    pm.expect(jsonData.pagination.next_cursor).to.not.be.null;",
									"});",
									"",
									"if (jsonData.pagination && jsonData.pagination.next_cursor) {",
									"    pm.collectionVariables.set(\"next_cursor\", jsonData.pagination.next_cursor);",
									"    console.log(\"Saved next_cursor:\", jsonData.pagination.next_cursor);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/books?strategy=cursor&limit=10&sort=-id",
