	"item": [
		{
			"name": "1. Offset Pagination",
			"item": [
				{
					"name": "1.1. Offset - Lấy trang đầu (offset=0, limit=10)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Strategy is offset\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.pagination.strategy).to.eql(\"offset\");",
									"    pm.expect(jsonData.data.length).to.be.at.most(10);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/books?strategy=offset&offset=0&limit=10",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"books"
							],
							"query": [
								{
									"key": "strategy",
									"value": "offset",
									"description": "Chiến lược phân trang"
								},
								{
									"key": "offset",
									"value": "0",
									"description": "Vị trí bắt đầu"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Số lượng bản ghi mỗi trang"
								}
							]
						}
					},
					"response": []
				},
